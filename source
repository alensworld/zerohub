-- ==================== UTILITY ====================
local function getChar(p) return p and p.Character end
local function getRoot(p)
    local c = getChar(p)
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")
end
local function getHead(p)
    local c = getChar(p)
    if not c then return nil end
    return c:FindFirstChild("Head")
end
local function getHumanoid(p)
    local c = getChar(p)
    if not c then return nil end
    return c:FindFirstChildOfClass("Humanoid")
end
local function isAlive(p)
    local h = getHumanoid(p)
    return h and h.Health > 0
end
local function isTeammate(p)
    if not Config.ESP.TeamCheck then return false end
    return p.Team and LP.Team and p.Team == LP.Team
end
local function worldToScreen(pos)
    local v, o = Camera:WorldToViewportPoint(pos)
    return Vector2.new(v.X, v.Y), o, v.Z
end
local function clamp(val, mn, mx)
    if val < mn then return mn end
    if val > mx then return mx end
    return val
end
local function safeDrawing(t)
    local ok, obj = pcall(function() return Drawing.new(t) end)
    if ok then return obj end
    return nil
end

