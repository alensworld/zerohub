UserInputService.JumpRequest:Connect(function()
    if Config.Player.InfiniteJump then
        local hum = getHumanoid(LP)
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- ==================== INPUT ====================
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    -- Aimbot key
    if input.UserInputType == Config.Aimbot.Key then
        aiming = true
    end

    -- Hotkeys
    if input.KeyCode == Enum.KeyCode.F1 then
        Config.ESP.Enabled = not Config.ESP.Enabled
        print("[LO Hub] ESP: " .. (Config.ESP.Enabled and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.F2 then
        Config.Aimbot.Enabled = not Config.Aimbot.Enabled
        print("[LO Hub] Aimbot: " .. (Config.Aimbot.Enabled and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.F3 then
        Config.Player.Speed = Config.Player.Speed == 16 and 50 or 16
        print("[LO Hub] Speed: " .. Config.Player.Speed)
    elseif input.KeyCode == Enum.KeyCode.F4 then
        Config.Player.Fly = not Config.Player.Fly
        print("[LO Hub] Fly: " .. (Config.Player.Fly and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.F5 then
        Config.Player.InfiniteJump = not Config.Player.InfiniteJump
        print("[LO Hub] Infinite Jump: " .. (Config.Player.InfiniteJump and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.F6 then
        Config.Player.Noclip = not Config.Player.Noclip
        print("[LO Hub] Noclip: " .. (Config.Player.Noclip and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.F7 then
        Config.Player.GodMode = not Config.Player.GodMode
        print("[LO Hub] God Mode: " .. (Config.Player.GodMode and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.F8 then
        Config.ESP.Tracers = not Config.ESP.Tracers
        print("[LO Hub] Tracers: " .. (Config.ESP.Tracers and "ON" or "OFF"))
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Config.Aimbot.Key then
        aiming = false
    end
end)

