-- ==================== CONFIG ====================
local Config = {
    ESP = {
        Enabled = false,
        Boxes = true,
        Names = true,
        Health = true,
        Distance = true,
        Tracers = false,
        MaxDistance = 1000,
        TeamCheck = false,
        EnemyColor = Color3.fromRGB(255, 0, 0),
        AllyColor = Color3.fromRGB(0, 255, 0),
    },
    Aimbot = {
        Enabled = false,
        Key = Enum.UserInputType.MouseButton2,
        Smoothness = 5,
        FOV = 120,
        ShowFOV = true,
        TargetPart = "Head",
        TeamCheck = false,
        MaxDistance = 500,
    },
    Player = {
        Speed = 16,
        JumpPower = 50,
        Fly = false,
        FlySpeed = 50,
        InfiniteJump = false,
        Noclip = false,
        GodMode = false,
    }
}

-- ==================== SERVICES ====================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LP = Players.LocalPlayer
local Mouse = LP:GetMouse()

-- ==================== UTILITY ====================
local function getChar(player)
    return player and player.Character
end

local function getRoot(player)
    local char = getChar(player)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
end

local function getHead(player)
    local char = getChar(player)
    if not char then return nil end
    return char:FindFirstChild("Head")
end

local function getHumanoid(player)
    local char = getChar(player)
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function isAlive(player)
    local hum = getHumanoid(player)
    return hum and hum.Health > 0
end

local function isTeammate(player)
    if not Config.ESP.TeamCheck then return false end
    return player.Team and LP.Team and player.Team == LP.Team
end

local function worldToScreen(pos)
    local vec, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(vec.X, vec.Y), onScreen, vec.Z
end

local function clamp(val, min, max)
    if val < min then return min end
    if val > max then return max end
    return val
end

-- ==================== DRAWING SAFETY ====================
local function safeDrawing(type)
    local ok, obj = pcall(function()
        return Drawing.new(type)
    end)
    if ok then return obj end
    return nil
end

-- ==================== ESP ====================
local ESPObjects = {}

local function createESP(player)
    if player == LP then return end
    if ESPObjects[player] then return end

    local esp = {player = player, drawings = {}}

    local box = safeDrawing("Square")
    if box then
        box.Thickness = 1
        box.Filled = false
        box.Transparency = 1
        box.Visible = false
        esp.drawings.box = box
    end

    local name = safeDrawing("Text")
    if name then
        name.Size = 13
        name.Center = true
        name.Outline = true
        name.Transparency = 1
        name.Visible = false
        esp.drawings.name = name
    end

    local healthBg = safeDrawing("Square")
    if healthBg then
        healthBg.Thickness = 1
        healthBg.Filled = true
        healthBg.Transparency = 0.5
        healthBg.Color = Color3.fromRGB(0, 0, 0)
        healthBg.Visible = false
        esp.drawings.healthBg = healthBg
    end

    local healthBar = safeDrawing("Square")
    if healthBar then
        healthBar.Thickness = 1
        healthBar.Filled = true
        healthBar.Transparency = 1
        healthBar.Visible = false
        esp.drawings.healthBar = healthBar
    end

    local dist = safeDrawing("Text")
    if dist then
        dist.Size = 12
        dist.Center = true
        dist.Outline = true
        dist.Transparency = 1
        dist.Visible = false
        esp.drawings.dist = dist
    end

    local tracer = safeDrawing("Line")
    if tracer then
        tracer.Thickness = 1
        tracer.Transparency = 1
        tracer.Visible = false
        esp.drawings.tracer = tracer
    end

    ESPObjects[player] = esp
end

local function removeESP(player)
    local esp = ESPObjects[player]
    if not esp then return end
    for _, drawing in pairs(esp.drawings) do
        pcall(function() drawing:Remove() end)
    end
    ESPObjects[player] = nil
end

local function hideAll(esp)
    for _, d in pairs(esp.drawings) do
        d.Visible = false
    end
end

local function updateESP()
    for player, esp in pairs(ESPObjects) do
        local ok, err = pcall(function()
            local visible = Config.ESP.Enabled and isAlive(player)
            local color = isTeammate(player) and Config.ESP.AllyColor or Config.ESP.EnemyColor

            if not visible or not getChar(player) then
                hideAll(esp)
                return
            end

            local root = getRoot(player)
            local head = getHead(player)
            if not root or not head then
                hideAll(esp)
                return
            end

            local rootPos = root.Position
            local myRoot = getRoot(LP)
            if not myRoot then
                hideAll(esp)
                return
            end

            local distance = (rootPos - myRoot.Position).Magnitude
            if distance > Config.ESP.MaxDistance then
                hideAll(esp)
                return
            end

            local topPos, topOnScreen = worldToScreen((head.CFrame * CFrame.new(0, 1.5, 0)).Position)
            local bottomPos, bottomOnScreen = worldToScreen((root.CFrame * CFrame.new(0, -3, 0)).Position)

            if not topOnScreen and not bottomOnScreen then
                hideAll(esp)
                return
            end

            local boxHeight = math.abs(bottomPos.Y - topPos.Y)
            local boxWidth = boxHeight * 0.55

            if Config.ESP.Boxes and esp.drawings.box then
                esp.drawings.box.Size = Vector2.new(boxWidth, boxHeight)
                esp.drawings.box.Position = Vector2.new(topPos.X - boxWidth / 2, topPos.Y)
                esp.drawings.box.Color = color
                esp.drawings.box.Visible = true
            elseif esp.drawings.box then
                esp.drawings.box.Visible = false
            end

            if Config.ESP.Names and esp.drawings.name then
                esp.drawings.name.Text = player.DisplayName
                esp.drawings.name.Position = Vector2.new(topPos.X, topPos.Y - 16)
                esp.drawings.name.Color = Color3.fromRGB(255, 255, 255)
                esp.drawings.name.Visible = true
            elseif esp.drawings.name then
                esp.drawings.name.Visible = false
            end

            if Config.ESP.Health and esp.drawings.healthBg and esp.drawings.healthBar then
                local hum = getHumanoid(player)
                local ratio = 0
                if hum then ratio = clamp(hum.Health / hum.MaxHealth, 0, 1) end
                local barX = topPos.X - boxWidth / 2 - 6

                esp.drawings.healthBg.Size = Vector2.new(3, boxHeight)
                esp.drawings.healthBg.Position = Vector2.new(barX, topPos.Y)
                esp.drawings.healthBg.Visible = true

                local barH = boxHeight * ratio
                esp.drawings.healthBar.Size = Vector2.new(3, barH)
                esp.drawings.healthBar.Position = Vector2.new(barX, topPos.Y + (boxHeight - barH))
                esp.drawings.healthBar.Color = Color3.fromRGB(255 * (1 - ratio), 255 * ratio, 0)
                esp.drawings.healthBar.Visible = true
            elseif esp.drawings.healthBg then
                esp.drawings.healthBg.Visible = false
                if esp.drawings.healthBar then esp.drawings.healthBar.Visible = false end
            end

            if Config.ESP.Distance and esp.drawings.dist then
                esp.drawings.dist.Text = string.format("[%dm]", math.floor(distance))
                esp.drawings.dist.Position = Vector2.new(bottomPos.X, bottomPos.Y + 2)
                esp.drawings.dist.Color = Color3.fromRGB(200, 200, 200)
                esp.drawings.dist.Visible = true
            elseif esp.drawings.dist then
                esp.drawings.dist.Visible = false
            end

            if Config.ESP.Tracers and esp.drawings.tracer then
                local viewportSize = Camera.ViewportSize
                esp.drawings.tracer.From = Vector2.new(viewportSize.X / 2, viewportSize.Y)
                esp.drawings.tracer.To = bottomPos
                esp.drawings.tracer.Color = color
                esp.drawings.tracer.Visible = true
            elseif esp.drawings.tracer then
                esp.drawings.tracer.Visible = false
            end
        end)
    end
end

-- ==================== AIMBOT ====================
local AimFOVCircle = safeDrawing("Circle")
if AimFOVCircle then
    AimFOVCircle.Thickness = 1
    AimFOVCircle.Filled = false
    AimFOVCircle.Transparency = 0.5
    AimFOVCircle.Color = Color3.fromRGB(255, 255, 255)
    AimFOVCircle.NumSides = 64
    AimFOVCircle.Visible = false
end

local aiming = false

local function getClosestTarget()
    local closest = nil
    local closestDist = Config.Aimbot.FOV
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and isAlive(player) then
            if not (Config.Aimbot.TeamCheck and isTeammate(player)) then
                local char = getChar(player)
                if char then
                    local targetPart = char:FindFirstChild(Config.Aimbot.TargetPart)
                    if targetPart then
                        local myRoot = getRoot(LP)
                        local inRange = true
                        if myRoot then
                            inRange = (targetPart.Position - myRoot.Position).Magnitude <= Config.Aimbot.MaxDistance
                        end

                        if inRange then
                            local screenPos, onScreen = worldToScreen(targetPart.Position)
                            if onScreen then
                                local dist = (screenPos - screenCenter).Magnitude
                                if dist < closestDist then
                                    closestDist = dist
                                    closest = targetPart
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return closest
end

local function updateAimbot()
    if AimFOVCircle then
        if Config.Aimbot.Enabled and Config.Aimbot.ShowFOV then
            AimFOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            AimFOVCircle.Radius = Config.Aimbot.FOV
            AimFOVCircle.Visible = true
        else
            AimFOVCircle.Visible = false
        end
    end

    if not Config.Aimbot.Enabled or not aiming then return end

    local target = getClosestTarget()
    if not target then return end

    local targetPos = target.Position
    local smoothness = Config.Aimbot.Smoothness

    local currentCF = Camera.CFrame
    local targetCF = CFrame.lookAt(currentCF.Position, targetPos)
    Camera.CFrame = currentCF:Lerp(targetCF, 1 / smoothness)
end

-- ==================== PLAYER MODS ====================
local flyActive = false
local flyBV = nil

local function updatePlayerMods()
    local hum = getHumanoid(LP)
    local root = getRoot(LP)
    if not hum or not root then return end

    if Config.Player.Speed ~= 16 then
        hum.WalkSpeed = Config.Player.Speed
    end

    if Config.Player.JumpPower ~= 50 then
        hum.JumpPower = Config.Player.JumpPower
        hum.UseJumpPower = true
    end

    if Config.Player.GodMode then
        hum.MaxHealth = math.huge
        hum.Health = math.huge
    end

    if Config.Player.Noclip then
        local char = getChar(LP)
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end

    if Config.Player.Fly then
        if not flyActive then
            flyBV = Instance.new("BodyVelocity")
            flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            flyBV.Velocity = Vector3.new(0, 0, 0)
            flyBV.Parent = root
            hum.PlatformStand = true
            flyActive = true
        end

        local dir = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            dir = dir + Camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            dir = dir - Camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            dir = dir - Camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            dir = dir + Camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            dir = dir + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            dir = dir - Vector3.new(0, 1, 0)
        end

        flyBV.Velocity = dir * Config.Player.FlySpeed
    elseif flyActive then
        if flyBV then flyBV:Destroy() end
        local hum2 = getHumanoid(LP)
        if hum2 then hum2.PlatformStand = false end
        flyActive = false
    end
end

-- ==================== INFINITE JUMP ====================
UserInputService.JumpRequest:Connect(function()
    if Config.Player.InfiniteJump then
        local hum = getHumanoid(LP)
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- ==================== INPUT ====================
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    if input.UserInputType == Config.Aimbot.Key then
        aiming = true
    end

    if input.KeyCode == Enum.KeyCode.F1 then
        Config.ESP.Enabled = not Config.ESP.Enabled
        print("[LO Hub] ESP: " .. (Config.ESP.Enabled and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.F2 then
        Config.Aimbot.Enabled = not Config.Aimbot.Enabled
        print("[LO Hub] Aimbot: " .. (Config.Aimbot.Enabled and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.F3 then
        Config.Player.Speed = Config.Player.Speed == 16 and 50 or 16
        print("[LO Hub] Speed: " .. Config.Player.Speed)
    elseif input.KeyCode == Enum.KeyCode.F4 then
        Config.Player.Fly = not Config.Player.Fly
        print("[LO Hub] Fly: " .. (Config.Player.Fly and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.F5 then
        Config.Player.InfiniteJump = not Config.Player.InfiniteJump
        print("[LO Hub] Infinite Jump: " .. (Config.Player.InfiniteJump and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.F6 then
        Config.Player.Noclip = not Config.Player.Noclip
        print("[LO Hub] Noclip: " .. (Config.Player.Noclip and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.F7 then
        Config.Player.GodMode = not Config.Player.GodMode
        print("[LO Hub] God Mode: " .. (Config.Player.GodMode and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.F8 then
        Config.ESP.Tracers = not Config.ESP.Tracers
        print("[LO Hub] Tracers: " .. (Config.ESP.Tracers and "ON" or "OFF"))
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Config.Aimbot.Key then
        aiming = false
    end
end)

-- ==================== PLAYER EVENTS ====================
Players.PlayerAdded:Connect(function(player)
    createESP(player)
end)

Players.PlayerRemoving:Connect(function(player)
    removeESP(player)
end)

for _, player in ipairs(Players:GetPlayers()) do
    createESP(player)
end

-- ==================== MAIN LOOP ====================
RunService.RenderStepped:Connect(function()
    pcall(updateESP)
    pcall(updateAimbot)
    pcall(updatePlayerMods)
end)

