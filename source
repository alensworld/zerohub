-- ==================== ESP SYSTEM ====================
local ESPObjects = {}

local function createESP(player)
    if player == LP then return end
    if ESPObjects[player] then return end
    local esp = {player = player, drawings = {}}

    local box = safeDrawing("Square")
    if box then box.Thickness = 1; box.Filled = false; box.Transparency = 1; box.Visible = false; esp.drawings.box = box end

    local name = safeDrawing("Text")
    if name then name.Size = 13; name.Center = true; name.Outline = true; name.Transparency = 1; name.Visible = false; esp.drawings.name = name end

    local hBg = safeDrawing("Square")
    if hBg then hBg.Thickness = 1; hBg.Filled = true; hBg.Transparency = 0.5; hBg.Color = Color3.fromRGB(0,0,0); hBg.Visible = false; esp.drawings.healthBg = hBg end

    local hBar = safeDrawing("Square")
    if hBar then hBar.Thickness = 1; hBar.Filled = true; hBar.Transparency = 1; hBar.Visible = false; esp.drawings.healthBar = hBar end

    local dist = safeDrawing("Text")
    if dist then dist.Size = 12; dist.Center = true; dist.Outline = true; dist.Transparency = 1; dist.Visible = false; esp.drawings.dist = dist end

    local tracer = safeDrawing("Line")
    if tracer then tracer.Thickness = 1; tracer.Transparency = 1; tracer.Visible = false; esp.drawings.tracer = tracer end

    ESPObjects[player] = esp
end

local function removeESP(player)
    local esp = ESPObjects[player]
    if not esp then return end
    for _, d in pairs(esp.drawings) do pcall(function() d:Remove() end) end
    ESPObjects[player] = nil
end

local function hideAll(esp)
    for _, d in pairs(esp.drawings) do d.Visible = false end
end

local function updateESP()
    for player, esp in pairs(ESPObjects) do
        pcall(function()
            if not Config.ESP.Enabled or not isAlive(player) or not getChar(player) then
                hideAll(esp); return
            end

            local root, head = getRoot(player), getHead(player)
            local myRoot = getRoot(LP)
            if not root or not head or not myRoot then hideAll(esp); return end

            local distance = (root.Position - myRoot.Position).Magnitude
            if distance > Config.ESP.MaxDistance then hideAll(esp); return end

            local color = isTeammate(player) and Config.ESP.AllyColor or Config.ESP.EnemyColor
            local topPos, topOn = worldToScreen((head.CFrame * CFrame.new(0,1.5,0)).Position)
            local bottomPos, bottomOn = worldToScreen((root.CFrame * CFrame.new(0,-3,0)).Position)
            if not topOn and not bottomOn then hideAll(esp); return end

            local boxH = math.abs(bottomPos.Y - topPos.Y)
            local boxW = boxH * 0.55

            if Config.ESP.Boxes and esp.drawings.box then
                esp.drawings.box.Size = Vector2.new(boxW, boxH)
                esp.drawings.box.Position = Vector2.new(topPos.X - boxW/2, topPos.Y)
                esp.drawings.box.Color = color; esp.drawings.box.Visible = true
            elseif esp.drawings.box then esp.drawings.box.Visible = false end

            if Config.ESP.Names and esp.drawings.name then
                esp.drawings.name.Text = player.DisplayName
                esp.drawings.name.Position = Vector2.new(topPos.X, topPos.Y - 16)
                esp.drawings.name.Color = Color3.fromRGB(255,255,255); esp.drawings.name.Visible = true
            elseif esp.drawings.name then esp.drawings.name.Visible = false end

            if Config.ESP.Health and esp.drawings.healthBg and esp.drawings.healthBar then
                local hum = getHumanoid(player)
                local ratio = hum and clamp(hum.Health/hum.MaxHealth, 0, 1) or 0
                local barX = topPos.X - boxW/2 - 6
                esp.drawings.healthBg.Size = Vector2.new(3, boxH)
                esp.drawings.healthBg.Position = Vector2.new(barX, topPos.Y); esp.drawings.healthBg.Visible = true
                local barH = boxH * ratio
                esp.drawings.healthBar.Size = Vector2.new(3, barH)
                esp.drawings.healthBar.Position = Vector2.new(barX, topPos.Y + (boxH - barH))
                esp.drawings.healthBar.Color = Color3.fromRGB(255*(1-ratio), 255*ratio, 0); esp.drawings.healthBar.Visible = true
            elseif esp.drawings.healthBg then esp.drawings.healthBg.Visible = false; if esp.drawings.healthBar then esp.drawings.healthBar.Visible = false end end

            if Config.ESP.Distance and esp.drawings.dist then
                esp.drawings.dist.Text = string.format("[%dm]", math.floor(distance))
                esp.drawings.dist.Position = Vector2.new(bottomPos.X, bottomPos.Y + 2)
                esp.drawings.dist.Color = Color3.fromRGB(200,200,200); esp.drawings.dist.Visible = true
            elseif esp.drawings.dist then esp.drawings.dist.Visible = false end

            if Config.ESP.Tracers and esp.drawings.tracer then
                local vs = Camera.ViewportSize
                esp.drawings.tracer.From = Vector2.new(vs.X/2, vs.Y)
                esp.drawings.tracer.To = bottomPos; esp.drawings.tracer.Color = color; esp.drawings.tracer.Visible = true
            elseif esp.drawings.tracer then esp.drawings.tracer.Visible = false end
        end)
    end
end

-- ==================== AIMBOT ====================
local AimFOVCircle = safeDrawing("Circle")
if AimFOVCircle then
    AimFOVCircle.Thickness = 1; AimFOVCircle.Filled = false; AimFOVCircle.Transparency = 0.5
    AimFOVCircle.Color = Color3.fromRGB(255,255,255); AimFOVCircle.NumSides = 64; AimFOVCircle.Visible = false
end

local aiming = false

local function getClosestTarget()
    local closest, closestDist = nil, Config.Aimbot.FOV
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and isAlive(p) and not (Config.Aimbot.TeamCheck and isTeammate(p)) then
            local c = getChar(p)
            if c then
                local tp = c:FindFirstChild(Config.Aimbot.TargetPart)
                if tp then
                    local myR = getRoot(LP)
                    if not myR or (tp.Position - myR.Position).Magnitude <= Config.Aimbot.MaxDistance then
                        local sp, on = worldToScreen(tp.Position)
                        if on then
                            local d = (sp - center).Magnitude
                            if d < closestDist then closestDist = d; closest = tp end
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function updateAimbot()
    if AimFOVCircle then
        if Config.Aimbot.Enabled and Config.Aimbot.ShowFOV then
            AimFOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
            AimFOVCircle.Radius = Config.Aimbot.FOV; AimFOVCircle.Visible = true
        else AimFOVCircle.Visible = false end
    end
    if not Config.Aimbot.Enabled or not aiming then return end
    local target = getClosestTarget()
    if not target then return end
    local cur = Camera.CFrame
    local goal = CFrame.lookAt(cur.Position, target.Position)
    Camera.CFrame = cur:Lerp(goal, 1 / Config.Aimbot.Smoothness)
end

-- ==================== PLAYER MODS ====================
local flyActive, flyBV = false, nil

local function updatePlayerMods()
    local hum, root = getHumanoid(LP), getRoot(LP)
    if not hum or not root then return end

    if Config.Player.Speed ~= 16 then hum.WalkSpeed = Config.Player.Speed end
    if Config.Player.JumpPower ~= 50 then hum.JumpPower = Config.Player.JumpPower; hum.UseJumpPower = true end
    if Config.Player.GodMode then hum.MaxHealth = math.huge; hum.Health = math.huge end

    if Config.Player.Noclip then
        local ch = getChar(LP)
        if ch then for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end end
    end

    if Config.Player.Fly then
        if not flyActive then
            flyBV = Instance.new("BodyVelocity")
            flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            flyBV.Velocity = Vector3.new(0,0,0); flyBV.Parent = root
            hum.PlatformStand = true; flyActive = true
        end
        local dir = Vector3.new(0,0,0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end
        flyBV.Velocity = dir * Config.Player.FlySpeed
    elseif flyActive then
        if flyBV then flyBV:Destroy() end
        local h2 = getHumanoid(LP); if h2 then h2.PlatformStand = false end
        flyActive = false
    end
end

